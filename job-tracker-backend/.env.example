# Set these as environment variables before starting Spring Boot.
# Do not commit real passwords or API secrets.
DB_URL=jdbc:postgresql://localhost:5432/job_tracker_db
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
JWT_SECRET=replace-with-a-long-random-secret

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password

# Automatic Gmail inbox tracking using IMAP. This tracks the inbox for one
# Job Tracker account per backend instance. Use a Gmail App Password.
MAIL_TRACKING_ENABLED=false
MAIL_TRACKING_IMAP_HOST=imap.gmail.com
MAIL_TRACKING_IMAP_PORT=993
MAIL_TRACKING_USERNAME=yourgmail@gmail.com
MAIL_TRACKING_PASSWORD=your-16-character-gmail-app-password
MAIL_TRACKING_OWNER_EMAIL=the-email-used-to-sign-up-to-job-tracker
MAIL_TRACKING_POLL_INTERVAL_MS=60000

# Razorpay Test Mode credentials from your Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional
NOTIFICATION_SCHEDULER_DELAY_MS=30000
